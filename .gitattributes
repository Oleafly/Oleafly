# Scoped deliberately: a repo-wide `text=auto eol=lf` would renormalise the
# committed pnpm store and vendored patches, so only the files whose exact
# bytes matter are declared here.

# Vendored upstream payloads are checksum-pinned against what upstream
# published. Any end-of-line translation changes their bytes and the pin fails
# on Windows checkouts only.
# Anchored patterns: a gitattributes pattern containing a slash matches from
# the repo root, so `resources/licenses/**` silently misses the real location
# under src-tauri/.
**/resources/licenses/** -text
*.tar.gz binary
*.zip binary

# Parsed with "\n"-based markers by scripts/fetch-language-servers.node-tests.mjs.
.github/workflows/*.yml text eol=lf

# Vitest's module runner cannot load a CRLF hashbang in this imported script.
scripts/update-tagging-status.mjs text eol=lf


src-tauri/resources/templates/**/*.tex text eol=lf
src-tauri/resources/templates/**/*.typ text eol=lf
src-tauri/resources/templates/**/*.bib text eol=lf
src-tauri/resources/templates/**/*.md text eol=lf
src-tauri/resources/templates/**/*.json text eol=lf
src-tauri/linux/** text eol=lf
src-tauri/windows/*.nsh text eol=lf
src-tauri/windows/*.wxs text eol=lf

src-tauri/resources/typst-toolchain.json text eol=lf
crates/oleafly-core/tests/fixtures/typst-log/*.log text eol=lf

# Bundled citation styles ship inside the app, and the performance budget
# counts their bytes. A CRLF checkout on Windows makes them 13 KB larger.
src/assets/csl/*.csl text eol=lf

# CLI golden fixtures. The TypeScript generator and the Rust tests compare
# UTF-16 offsets, so case tables and expected output keep LF everywhere.
# Project sources keep their committed bytes (one fixture is CRLF on purpose)
# and the PDFs are binary.
crates/oleafly-preflight/tests/fixtures/** text eol=lf
crates/oleafly-preflight/tests/fixtures/projects/*/project/** -text
crates/oleafly-preflight/tests/fixtures/pdf/** binary
crates/oleafly-lint/tests/fixtures/** text eol=lf
