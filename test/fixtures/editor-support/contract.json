        {
          "engine": "typst",
          "surfaces": ["source"],
          "extensions": [".typ"]
        },
        {
          "engine": "bibtex",
          "surfaces": ["source"],
          "extensions": [".bib"]
        }
      ],
      "acceptanceCriteria": [
        {
          "id": "ASH-01",
          "statement": "Constructs covered by the representative corpus and feature grammar suites receive engine-correct token classes in every declared source extension.",
          "requiredEvidence": ["unit", "integration", "fixture"]
        },
        {
          "id": "ASH-02",
          "statement": "Incomplete and malformed input retains useful highlighting around damage, stays editable, and shows a diagnostic or partial state without crashing.",
          "requiredEvidence": ["unit", "integration", "fixture"]
        },
        {
          "id": "ASH-03",
          "statement": "Incremental highlighting paints only the current revision and meets the visible-syntax and main-thread budgets.",
          "requiredEvidence": ["integration", "performance"]
        },
        {
          "id": "ASH-04",
          "statement": "Extension routing is case-insensitive for declared extensions and does not grant full support to lookalike or explicitly excluded suffixes.",
          "requiredEvidence": ["unit", "fixture"]
        }
      ]
    },
    {
      "id": "live-reference-checking",
      "name": "Live Reference Checking",
      "required": true,
      "applicability": [
        {
          "engine": "latex",
          "surfaces": ["source", "visual"],
          "extensions": [".tex", ".ltx", ".latex"]
        },
        {
          "engine": "latex",
          "surfaces": ["source"],
          "extensions": [".sty", ".cls"]
        },
        {
          "engine": "markdown",
          "surfaces": ["source", "visual"],
          "extensions": [".md", ".markdown"]
        },
        {
          "engine": "typst",
          "surfaces": ["source"],
          "extensions": [".typ"]
        }
      ],
      "acceptanceCriteria": [
        {
          "id": "LRC-01",
          "statement": "Local and cross-file labels, anchors, links, includes, imports, and relevant asset targets resolve with engine-correct syntax.",
          "requiredEvidence": ["unit", "integration", "fixture"]
        },
        {
          "id": "LRC-02",
          "statement": "Missing and duplicate targets are reported at every affected range, while valid targets produce no false error.",
          "requiredEvidence": ["unit", "integration", "fixture"]
        },
        {
          "id": "LRC-03",
          "statement": "Malformed/unreadable files yield visible partial/error states and never a false \"no issues\" result.",
          "requiredEvidence": ["integration", "end-to-end", "fixture"]
        },
        {
          "id": "LRC-04",
          "statement": "File create, edit, rename, move, and delete invalidate affected project state, reject stale results, and pass project-analysis budgets.",
          "requiredEvidence": ["integration", "end-to-end", "performance"]
        }
      ]
    },
    {
      "id": "integrated-pdf-viewer",
      "name": "Integrated PDF Viewer",
      "required": true,
      "applicability": [
        {
          "engine": "latex",
          "surfaces": ["pdf"],
          "extensions": [".tex", ".ltx", ".latex"]
        },
        {
          "engine": "markdown",
          "surfaces": ["pdf"],
          "extensions": [".md", ".markdown"]
        },
        {
          "engine": "typst",
          "surfaces": ["pdf"],
          "extensions": [".typ"]
        }
      ],
      "acceptanceCriteria": [
        {
          "id": "PDF-01",
          "statement": "The latest successful PDF bytes from each supported engine render without engine-specific viewer regressions.",
          "requiredEvidence": ["integration", "end-to-end", "fixture"]
        },
        {
          "id": "PDF-02",
          "statement": "Page navigation, zoom/fit, scrolling, text selection/search, links, and download work on representative single- and multi-page documents.",
          "requiredEvidence": ["end-to-end"]
        },
        {
          "id": "PDF-03",
          "statement": "Missing, invalid, unavailable, and failed loads show truthful visible states rather than blank success.",
          "requiredEvidence": ["integration", "end-to-end"]
        },
        {
          "id": "PDF-04",
          "statement": "A stale compile or PDF load can never replace the accepted PDF. A retained last-good PDF for a pending or failed newer project revision is prominently marked stale and is never represented as current.",
          "requiredEvidence": ["integration", "end-to-end"]
        }
      ]
    },
    {
      "id": "live-inline-preview",
      "name": "Live Inline Preview",
      "required": true,
      "applicability": [
        {
          "engine": "latex",
          "surfaces": ["source", "visual"],
          "extensions": [".tex", ".ltx", ".latex"]
        },
        {
          "engine": "markdown",
          "surfaces": ["source", "visual"],
          "extensions": [".md", ".markdown"]
        }
      ],
      "acceptanceCriteria": [
        {
          "id": "LIP-01",
          "statement": "Supported inline and display math forms render their exact source and refresh after edits in both engines.",
          "requiredEvidence": ["unit", "integration", "fixture"]
        },
        {
          "id": "LIP-02",
          "statement": "Preview decorations never alter source, block cursor/selection operations, hide the editable expression, or create an inaccessible focus trap.",
          "requiredEvidence": ["integration", "end-to-end"]
        },
        {
          "id": "LIP-03",
          "statement": "Incomplete or invalid math stays editable and shows a visible, non-destructive fallback instead of throwing or disappearing silently.",
          "requiredEvidence": ["unit", "integration", "end-to-end"]
        },
        {
          "id": "LIP-04",
          "statement": "Only current-revision output is painted, and refresh meets inline and main-thread budgets.",
          "requiredEvidence": ["integration", "performance"]
        }
      ]
    },
    {
      "id": "latex-commands-completion-and-syntax-checking",
      "name": "LaTeX Commands Completion and Syntax Checking",
      "required": true,
      "applicability": [
        {
          "engine": "latex",
          "surfaces": ["source"],
          "extensions": [".tex", ".ltx", ".latex", ".sty", ".cls"]
        }
      ],
      "acceptanceCriteria": [
        {
          "id": "LCS-01",
          "statement": "Commands, environments, argument forms, document classes/packages, and project-defined macros/environments complete in valid contexts.",
          "requiredEvidence": ["unit", "integration", "fixture"]
        },
        {
          "id": "LCS-02",
          "statement": "Unclosed or mismatched delimiters/environments, malformed command forms, and parser errors receive accurate current-revision diagnostics.",
          "requiredEvidence": ["unit", "integration", "fixture"]
        },
        {
          "id": "LCS-03",
          "statement": "Completion remains available at incomplete command/argument sites; damaged neighboring source degrades visibly to partial results instead of disabling the file.",
          "requiredEvidence": ["unit", "integration"]
        },
        {
          "id": "LCS-04",
          "statement": "Cached and project-backed completion meet their latency gates, and a stale completion item cannot be committed.",
          "requiredEvidence": ["integration", "performance"]
        }
      ]
    },
    {
      "id": "live-grammar-checking",
      "name": "Live Grammar Checking",
      "required": true,
      "applicability": [
        {
          "engine": "latex",
          "surfaces": ["source", "visual"],
          "extensions": [".tex", ".ltx", ".latex"]
        },
        {
          "engine": "markdown",
          "surfaces": ["source", "visual"],
