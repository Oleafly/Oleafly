  "features": [
    {
      "id": "advanced-syntax-highlighting",
      "name": "Advanced Syntax Highlighting",
      "required": true,
      "applicability": [
        {
          "engine": "latex",
          "surfaces": ["source"],
          "extensions": [".tex", ".ltx", ".latex", ".sty", ".cls"]
        },
        {
          "engine": "markdown",
          "surfaces": ["source"],
          "extensions": [".md", ".markdown"]
