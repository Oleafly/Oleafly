        {
          "engine": "typst",
          "surfaces": ["source"],
          "extensions": [".typ"]
        }
      ],
      "acceptanceCriteria": [
        {
          "id": "LGC-01",
          "statement": "Harper checks English prose under all five declared dialects, and diagnostics/suggestions reflect the active dialect.",
