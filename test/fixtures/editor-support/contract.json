  "proofing": {
    "grammar": {
      "language": "English",
      "dialects": [
        {
          "name": "American English",
          "locale": "en-US"
        },
        {
          "name": "British English",
          "locale": "en-GB"
        },
        {
          "name": "Australian English",
          "locale": "en-AU"
        },
        {
          "name": "Canadian English",
          "locale": "en-CA"
        },
        {
          "name": "Indian English",
          "locale": "en-IN"
        }
      ]
    },
    "spelling": {
      "baselinePack": "en-US",
      "dictionaryDirectory": "public/dictionaries",
      "shippedPackDefinition": {
        "requiredFiles": [".aff", ".dic"],
        "sameBasename": true
      },
      "releaseScope": "all-shipped-paired-packs",
      "requiredChecks": [
        "load",
        "known-word",
        "known-misspelling",
        "suggestions",
        "user-dictionary"
      ],
      "releaseBlockingConditions": [
        "missing-baseline-pack",
        "orphaned-aff",
        "orphaned-dic",
        "pack-load-failure"
      ],
      "requestedUnavailablePackState": "unavailable",
      "fallbackPolicy": "allowed-only-with-truthful-active-pack-label"
    }
  },
  "visibleStateTaxonomy": [
    {
      "id": "unsupported",
      "kind": "state",
      "meaning": "The requested cell is explicitly outside this contract",
      "requiredPresentation": "Show an unsupported label and the reason"
    },
    {
      "id": "unavailable",
      "kind": "state",
      "meaning": "A supported capability or required local asset could not load",
      "requiredPresentation": "Name the unavailable capability and offer retry or setup where actionable"
    },
    {
      "id": "not_run",
      "kind": "state",
      "meaning": "No current-revision result has completed",
      "requiredPresentation": "Show not run or pending; never show success or \"no issues\""
    },
    {
      "id": "error",
      "kind": "state",
      "meaning": "The current-revision operation failed",
      "requiredPresentation": "Show the failure at the affected surface with actionable detail and retry"
    },
    {
      "id": "partial",
      "kind": "state",
      "meaning": "Recovery produced incomplete current-revision results",
      "requiredPresentation": "Show recovered results together with a partial-analysis indicator and syntax diagnostics"
    },
    {
      "id": "success",
      "kind": "state",
      "meaning": "A complete current-revision operation succeeded",
      "requiredPresentation": "Show current results; an empty result may say \"no issues\""
    },
    {
      "id": "stale",
      "kind": "modifier",
      "meaning": "Accepted output belongs to an older project revision",
      "requiredPresentation": "Mark the retained output prominently as stale"
    },
    {
      "id": "non_current",
      "kind": "modifier",
      "meaning": "Displayed output does not represent the active project revision",
      "requiredPresentation": "Explicitly identify that the output is not current"
    }
  ],
  "resultPolicies": {
    "analysisProofingParse": {
      "staleResponseDisposition": "reject-without-commit"
    },
    "compilePdfLoad": {
      "revisionIdentity": {
        "field": "projectRevision",
        "scope": "whole-project",
        "appliesTo": ["compile-result", "pdf-load-result"],
        "acceptOnlyWhenCapturedEqualsCurrent": true,
        "advancesOnChangesTo": [
          "main-document",
          "included-files",
          "imported-files",
          "bibliographies",
          "assets"
        ]
      },
      "staleResponseDisposition": "reject-without-replacing-accepted-pdf",
      "lastGoodPdf": {
        "retentionAllowedWhileNewerRevision": ["pending", "failed"],
        "requiredVisibleModifiers": ["stale", "non_current"],
        "currentRevisionClaim": "forbidden"
      }
    },
    "limits": {
      "silentCutoffs": "forbidden",
      "timeouts": "error",
      "emptySuccessRequires": "complete-current-revision-run"
    }
  },
  "performance": {
    "referenceHardware": {
      "machine": "Mac mini",
      "chip": "M1",
      "modelYear": 2020,
      "cpuCores": 8,
      "memoryGiB": 16,
      "storage": "SSD",
      "operatingSystem": "macOS 15",
      "power": "AC"
    },
    "methodology": {
      "warmupRuns": 3,
      "measuredRuns": 20,
      "statistic": "p95"
    },
    "functionalCrossPlatformGates": "separate",
    "referenceProject": {
      "maxFiles": 200,
      "totalCharacters": 500000
    },
    "singleDocumentStressCharacters": 500000,
    "maxMainThreadTaskMs": 50,
    "completionCachedP95Ms": 100,
    "completionProjectBackedP95Ms": 250,
    "syntaxVisibleUpdateP95Ms": 50,
    "diagnosticsStructureP95Ms": 750,
    "idleDebounceMs": 300,
    "proofing100kMs": 2000,
    "proofing500kMs": 8000,
    "inlineMathIdleMs": 500,
    "autoCompileStartMs": 3000
  },
