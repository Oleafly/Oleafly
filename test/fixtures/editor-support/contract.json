      "acceptanceCriteria": [
        {
          "id": "SGV-01",
          "statement": "The active file exposes an ordered, navigable, engine-correct local outline with stable source ranges.",
          "requiredEvidence": ["unit", "integration", "fixture"]
        },
        {
          "id": "SGV-02",
          "statement": "The project view merges all supported files into a navigable hierarchy and include/import/link graph without losing duplicate or unresolved nodes.",
          "requiredEvidence": ["integration", "fixture"]
        },
        {
          "id": "SGV-03",
          "statement": "Project-defined LaTeX symbols and BibTeX entries retain defining file/range and feed navigation and completion consumers.",
          "requiredEvidence": ["unit", "integration"]
        },
        {
          "id": "SGV-04",
          "statement": "Content/file mutations invalidate affected nodes, malformed files remain partially represented, stale graphs are rejected, and the 200-file/500,000 character project gate passes.",
          "requiredEvidence": ["integration", "fixture", "performance"]
        }
      ]
    },
    {
      "id": "citations-checking-and-completion",
      "name": "Citations Checking and Completion",
