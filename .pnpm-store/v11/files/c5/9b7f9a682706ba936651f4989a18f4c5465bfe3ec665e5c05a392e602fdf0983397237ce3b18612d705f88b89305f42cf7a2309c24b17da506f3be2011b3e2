appearance][1],\n    colorBgMask: scale.lightA[8],\n    colorBgSpotlight: scale[appearance][4],\n    colorBorder: scale[appearance][3],\n    colorBorderSecondary: scale[appearance][2],\n    colorFill: scale[`${appearance}A`][3],\n    colorFillQuaternary: scale[`${appearance}A`][0],\n    colorFillSecondary: scale[`${appearance}A`][2],\n    colorFillTertiary: scale[`${appearance}A`][1],\n    colorText: scale[appearance][12],\n    colorTextQuaternary: scale[appearance][6],\n    colorTextSecondary: scale[appearance][10],\n    colorTextTertiary: scale[appearance][8],\n  };\n};\n"],"mappings":";;AAKA,MAAa,wBAAwB,EACnC,MACA,OACA,iBAKyB;CACzB,MAAM,OAAO,WAAW,IAAI;CAC5B,MAAM,aAAa,eAAe;CAClC,OAAO;GACJ,QAAQ,KAAK,QAAQ,MAAM,GAAG,WAAW,GAAG,CAAC,aAAa,IAAI;GAC9D,QAAQ,KAAK,iBAAiB,MAAM,GAAG,WAAW,GAAG,CAAC,aAAa,IAAI;GACvE,QAAQ,KAAK,gBAAgB,MAAM,GAAG,WAAW,GAAG,CAAC,aAAa,IAAI;GACtE,QAAQ,KAAK,kBAAkB,MAAM,GAAG,WAAW,GAAG,CAAC,aAAa,IAAI;GACxE,QAAQ,KAAK,MAAM,MAAM,WAAW,CAAC;GACrC,QAAQ,KAAK,WAAW,MAAM,WAAW,CAAC;GAC1C,QAAQ,KAAK,UAAU,MAAM,WAAW,CAAC;GACzC,QAAQ,KAAK,eAAe,MAAM,WAAW,CAAC,aAAa,IAAI;GAC/D,QAAQ,KAAK,SAAS,MAAM,WAAW,CAAC,aAAa,KAAK;GAC1D,QAAQ,SAAS,MAAM,WAAW,CAAC;GACnC,QAAQ,KAAK,UAAU,MAAM,WAAW,CAAC,aAAa,IAAI;GAC1D,QAAQ,KAAK,aAAa,MAAM,WAAW,CAAC,aAAa,KAAK;GAC9D,QAAQ,KAAK,QAAQ,MAAM,WAAW,CAAC;GACvC,QAAQ,KAAK,cAAc,MAAM,WAAW,CAAC,aAAa,IAAI;CACjE;AACF;AAEA,MAAa,+BAA+B,EAC1C,OACA,iBAIyB;CACzB,OAAO;EACL,kBAAkB,eAAe,SAAS,MAAM,WAAW,CAAC,KAAK,MAAM,WAAW,CAAC;EACnF,iBAAiB,eAAe,SAAS,MAAM,WAAW,CAAC,KAAK,MAAM,WAAW,CAAC;EAClF,eAAe,eAAe,SAAS,MAAM,WAAW,CAAC,KAAK,MAAM,WAAW,CAAC;EAChF,aAAa,MAAM,OAAO;EAC1B,kBAAkB,MAAM,WAAW,CAAC;EACpC,aAAa,MAAM,WAAW,CAAC;EAC/B,sBAAsB,MAAM,WAAW,CAAC;EACxC,WAAW,MAAM,GAAG,WAAW,GAAG,CAAC;EACnC,qBAAqB,MAAM,GAAG,WAAW,GAAG,CAAC;EAC7C,oBAAoB,MAAM,GAAG,WAAW,GAAG,CAAC;EAC5C,mBAAmB,MAAM,GAAG,WAAW,GAAG,CAAC;EAC3C,WAAW,MAAM,WAAW,CAAC;EAC7B,qBAAqB,MAAM,WAAW,CAAC;EACvC,oBAAoB,MAAM,WAAW,CAAC;EACtC,mBAAmB,MAAM,WAAW,CAAC;CACvC;AACF"}