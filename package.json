{
  "name": "oleafly",
  "private": true,
  "version": "0.3.9",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13 <25"
  },
  "description": "Oleafly - the intelligent research workspace, free, local-first, 100% open source.",
  "license": "AGPL-3.0-or-later",
  "author": "Prajwal S Venkateshmurthy",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "language-servers:check": "node scripts/fetch-language-servers.mjs --check",
    "language-servers:fetch": "node scripts/fetch-language-servers.mjs",
    "language-servers:smoke": "node scripts/smoke-language-servers.mjs",
    "language-servers:test": "node --test scripts/fetch-language-servers.node-tests.mjs",
    "proofreading:node-test": "node --test scripts/hunspell.node-tests.mjs",
    "seed:research:sync": "node scripts/sync-research-seeds.mjs",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-sandbox.mjs",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:editor:performance": "vitest run --config vitest.editor-performance.config.ts",
    "test:watch": "vitest",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:app": "./scripts/e2e.sh"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "6.7.0",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@lobehub/icons": "^5.15.0",
    "@oleafly/ai-core": "workspace:*",
    "@oleafly/backend-port": "workspace:*",
    "@oleafly/ai-tools": "workspace:*",
    "@oleafly/diagram": "workspace:*",
    "@oleafly/editor": "workspace:*",
    "@oleafly/latex": "workspace:*",
    "@oleafly/latex-intelligence": "workspace:*",
    "@oleafly/preflight": "workspace:*",
    "@oleafly/preview": "workspace:*",
    "@oleafly/registry": "workspace:*",
    "@oleafly/templates": "workspace:*",
    "@oleafly/wysiwyg": "workspace:*",
    "@radix-ui/react-checkbox": "^1.3.10",
    "@radix-ui/react-context-menu": "^2.3.6",
    "@radix-ui/react-dialog": "^1.1.22",
    "@radix-ui/react-dropdown-menu": "^2.1.23",
    "@radix-ui/react-popover": "^1.1.22",
    "@radix-ui/react-radio-group": "^1.4.6",
    "@radix-ui/react-select": "^2.3.6",
    "@radix-ui/react-slot": "^1.3.2",
    "@radix-ui/react-switch": "^1.3.6",
    "@radix-ui/react-tabs": "^1.1.20",
    "@replit/codemirror-vim": "^6.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tiptap/core": "^3.29.0",
    "@tiptap/pm": "^3.29.0",
    "@tiptap/react": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "@unified-latex/unified-latex-types": "^1.8.4",
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "@unified-latex/unified-latex-util-print-raw": "^1.8.4",
    "@xyflow/react": "^12.11.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fflate": "0.8.3",
    "harper.js": "^2.4.0",
    "hunspell-asm": "^4.0.2",
    "katex": "^0.18.1",
    "lucide-react": "^0.540.0",
    "pdfjs-dist": "6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-joyride": "^3.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.7",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tiptap-markdown": "^0.9.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "^1.61.1",
    "@srsholmes/tauri-playwright": "^0.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "^29.1.1",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.3.3",
    "terser": "^5.49.0",
    "tw-animate-css": "^1.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
