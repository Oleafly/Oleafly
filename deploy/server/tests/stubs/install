#!/bin/sh
# Runs the real install, except when the destination's file name is the one
# in /stub/state/install-fails: that copy fails the way a full disk would.
if [ -s /stub/state/install-fails ]; then
	for target in "$@"; do :; done
	if [ "${target##*/}" = "$(cat /stub/state/install-fails)" ]; then
		echo "install: cannot create regular file '$target': No space left on device" >&2
		exit 1
	fi
fi
exec /usr/bin/install "$@"
