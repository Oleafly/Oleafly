{
  "$pack": {
    "name": "Fast math · Typst",
    "source": "https://github.com/gillescastel/latex-snippets",
    "licence": "MIT"
  },
  "fm-typst.inline-math": {
    "name": "Inline math",
    "nameKey": "snippets.records.inlineMath",
    "prefix": "mk",
    "body": "\\$$1\\$$0",
    "expand": "auto",
    "languages": ["typst"],
    "where": "text"
  },
  "fm-typst.display-math": {
    "name": "Display math",
    "nameKey": "snippets.records.displayMath",
    "prefix": "dm",
    "body": "\\$ $1 \\$$0",
    "expand": "auto",
    "languages": ["typst"],
    "where": "text",
    "lineStart": true
  },
  "fm-typst.subscript": {
    "name": "Subscript",
    "nameKey": "snippets.records.subscript",
    "prefix": "re:(?<![\\\\A-Za-z])([A-Za-z])(\\d)",
    "body": "[[0]]_[[1]]",
    "expand": "auto",
    "inWord": true,
    "languages": ["typst"],
    "where": "math"
  },
  "fm-typst.squared": {
    "name": "Squared",
    "nameKey": "snippets.records.squared",
    "prefix": "sr",
    "body": "^2",
    "expand": "auto",
    "inWord": true,
    "languages": ["typst"],
    "where": "math"
  },
  "fm-typst.cubed": {
