  "fm-typst.sum": {
    "name": "Sum",
    "nameKey": "snippets.records.sum",
    "prefix": "sum",
    "body": "sum_(${1:i=1})^${2:n} $0",
    "expand": "auto",
    "languages": ["typst"],
    "where": "math"
  },
  "fm-typst.lim": {
    "name": "Limit",
    "nameKey": "snippets.records.lim",
    "prefix": "lim",
    "body": "lim_(${1:n} -> ${2:infinity}) $0",
    "expand": "auto",
    "languages": ["typst"],
    "where": "math"
  },
  "fm-typst.dint": {
    "name": "Definite integral",
    "nameKey": "snippets.records.dint",
    "prefix": "dint",
    "body": "integral_(${1:a})^${2:b} $3 dif ${4:x}$0",
    "expand": "auto",
    "languages": ["typst"],
    "where": "math"
  },
