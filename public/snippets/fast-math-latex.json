{
  "$pack": {
    "name": "Fast math · LaTeX",
    "source": "https://github.com/gillescastel/latex-snippets",
    "licence": "MIT"
  },
  "fm.inline-math": {
    "name": "Inline math",
    "nameKey": "snippets.records.inlineMath",
    "prefix": "mk",
    "body": "\\$$1\\$$0",
    "expand": "auto",
    "languages": ["latex"],
    "where": "text"
  },
  "fm.display-math": {
    "name": "Display math",
    "nameKey": "snippets.records.displayMath",
    "prefix": "dm",
    "body": [
      "\\[",
      "\t$1",
      "\\]$0"
    ],
    "expand": "auto",
    "languages": ["latex"],
    "where": "text",
    "lineStart": true
  },
  "fm.fraction": {
    "name": "Fraction",
    "nameKey": "snippets.records.fraction",
    "prefix": "//",
    "body": "\\frac{$1}{$2}$0",
    "expand": "auto",
    "inWord": true,
    "languages": ["latex"],
    "where": "math"
  },
  "fm.postfix-fraction": {
    "name": "Fraction of the term before",
    "nameKey": "snippets.records.postfixFraction",
    "prefix": "re:(?<![\\\\A-Za-z])(\\d+|[A-Za-z]|\\\\[A-Za-z]+)/",
    "body": "\\frac{[[0]]}{$1}$0",
    "expand": "auto",
    "inWord": true,
    "languages": ["latex"],
    "where": "math"
  },
  "fm.subscript": {
    "name": "Subscript",
    "nameKey": "snippets.records.subscript",
    "prefix": "re:(?<![\\\\A-Za-z])([A-Za-z])(\\d)",
    "body": "[[0]]_[[1]]",
    "expand": "auto",
    "inWord": true,
    "languages": ["latex"],
    "where": "math"
  },
