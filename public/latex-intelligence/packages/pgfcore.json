      "start=${1:code}",
      "end=${1:code}",
      "point=${1:code}",
      "jump=${1:code}",
      "special=${1:code}",
      "point macro=${1:macro}",
      "special macro=${1:macro}",
      "start macro=${1:macro}",
      "end macro=${1:macro}",
      "jump macro=${1:macro}"
    ],
    "\\pgfparserset#c": [
      "silent",
      "status"
    ],
    "\\pgfpathgrid#c": [
      "stepx=",
      "stepy=",
