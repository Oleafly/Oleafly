{
  "args": [
    "\\usepackage/subfig#c",
    "\\usepackage/subfig#c,\\captionsetup#c,\\captionsetup*#c,\\DeclareCaptionStyle#c"
  ],
  "deps": [
    "caption",
    "keyval",
    "ragged2e"
  ],
  "envs": [],
  "keys": {
    "\\usepackage/subfig#c": [
      "caption",
      "config=${1:file name}",
      "font=${1|scriptsize,footnotesize,small,normalsize,large,Large,normalfont,up,it,sl,sc,md,bf,rm,sf,tt,singlespacing,onehalfspacing,doublespacing,normalcolor,normal|}",
      "labelfont=${1|scriptsize,footnotesize,small,normalsize,large,Large,normalfont,up,it,sl,sc,md,bf,rm,sf,tt,singlespacing,onehalfspacing,doublespacing,normalcolor,normal|}",
      "textfont=${1|scriptsize,footnotesize,small,normalsize,large,Large,normalfont,up,it,sl,sc,md,bf,rm,sf,tt,singlespacing,onehalfspacing,doublespacing,normalcolor,normal|}",
      "style=${1|default,ruled|}",
      "singlelinecheck",
      "format=${1|default,hang|}",
      "indention=",
      "hangindent=",
      "width=",
      "margin=",
      "parskip=",
      "justification=${1|justified,centering,centerlast,centerfirst,raggedright,raggedleft,Justified,Centering,RaggedRight,RaggedLeft|}",
      "labelformat=${1|original,empty,simple,brace,parens|}",
      "aboveskip=",
      "belowskip=",
      "labelsep=${1|none,colon,period,space,quad,newline,endash|}",
      "position=${1|top,above,bottom,below,auto|}"
    ],
    "\\usepackage/subfig#c,\\captionsetup#c,\\captionsetup*#c,\\DeclareCaptionStyle#c": [
      "lofdepth=${1:integer}",
      "lotdepth=${1:integer}",
      "listofformat=${1|empty,simple,parens,subsimple,subparens|}",
      "subrefformat=${1|empty,simple,parens,subsimple,subparens|}",
      "listofindent=",
      "listofnumwidth=",
      "farskip=",
      "captionskip=",
      "topadjust=",
      "nearskip="
    ]
  },
  "macros": [
    {
      "name": "DeclareCaptionListOfFormat",
      "snippet": "DeclareCaptionListOfFormat{${1:keyword}}{${2:code}}"
    },
    {
      "name": "DeclareSubrefFormat",
      "snippet": "DeclareSubrefFormat{${1:keyword}}{${2:code}}"
    },
    {
      "name": "Subref",
      "snippet": "Subref{${1:label}}"
    },
    {
      "name": "listsubcaptions"
    },
    {
      "name": "newsubfloat",
      "snippet": "newsubfloat[${2:kv-list}]{${1:float name}}"
    },
    {
      "name": "newsubfloat",
      "snippet": "newsubfloat{${1:float name}}"
    },
    {
      "name": "subfigure",
      "snippet": "subfigure[${2:listentry}][${3:subcaption}]{${1:body}}"
    },
    {
      "name": "subfigure",
      "snippet": "subfigure[${2:subcaption}]{${1:body}}"
    },
    {
      "name": "subfigure",
      "snippet": "subfigure{${1:body}}"
    },
    {
      "name": "subfigurename",
      "unusual": true
    },
    {
      "name": "subfloat",
      "snippet": "subfloat[${2:listentry}][${3:subcaption}]{${1:body}}"
    },
    {
      "name": "subfloat",
      "snippet": "subfloat[${2:subcaption}]{${1:body}}"
    },
    {
      "name": "subfloat",
      "snippet": "subfloat{${1:body}}"
    },
    {
      "name": "subref",
      "snippet": "subref{${1:label}}"
    },
    {
      "name": "subref*",
      "snippet": "subref*{${1:label}}"
    },
    {
      "name": "subtable",
      "snippet": "subtable[${2:listentry}][${3:subcaption}]{${1:body}}"
    },
    {
      "name": "subtable",
      "snippet": "subtable[${2:subcaption}]{${1:body}}"
    },
    {
      "name": "subtable",
      "snippet": "subtable{${1:body}}"
    },
    {
      "name": "subtablename",
      "unusual": true
    },
    {
      "name": "thesubfigure",
      "unusual": true
    },
    {
      "name": "thesubtable",
      "unusual": true
    }
  ]
}
