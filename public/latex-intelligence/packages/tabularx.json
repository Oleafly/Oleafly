{
  "args": [
    "\\usepackage/tabularx#c"
  ],
  "deps": [
    "array"
  ],
  "envs": [
    {
      "name": "tabularx",
      "snippet": "{${1:width}}[${3:pos}]{${2:preamble}}"
    },
    {
      "name": "tabularx",
      "snippet": "{${1:width}}{${2:preamble}}"
    }
  ],
  "keys": {
    "\\usepackage/tabularx#c": [
      "infoshow",
      "debugshow"
    ]
  },
  "macros": [
    {
      "name": "arraybackslash",
      "unusual": true
    },
    {
      "name": "tabularxcolumn",
      "unusual": true
    },
    {
      "name": "tracingtabularx",
      "unusual": true
    }
  ]
}
