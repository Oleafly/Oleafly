{
  "args": [
    "\\usepackage/color#c"
  ],
  "deps": [],
  "envs": [],
  "keys": {
    "\\usepackage/color#c": [
      "monochrome",
      "debugshow",
      "setpagesize",
      "nosetpagesize",
      "dvips",
      "xdvi",
      "dvipdf",
      "dvipdfm",
      "dvipdfmx",
      "pdftex",
      "luatex",
      "dvisvgm",
      "xetex",
      "dvipsone",
      "dviwindo",
      "emtex",
      "dviwin",
      "oztex",
      "textures",
      "pctexps",
      "pctexwin",
      "pctexhp",
      "pctex32",
      "truetex",
      "tcidvi",
      "vtex",
      "dvipsnames",
      "nodvipsnames",
      "usenames"
    ]
  },
  "macros": [
    {
      "name": "DefineNamedColor",
      "snippet": "DefineNamedColor{${1:type}}{${2:name}}{${3:model}}{${4:spec}}",
      "unusual": true
    },
    {
      "name": "color",
      "snippet": "color[${2:model}]{${1:color}}"
    },
    {
      "name": "color",
      "snippet": "color{${1:color}}"
    },
    {
      "name": "colorbox",
      "snippet": "colorbox[${3:model}]{${1:color}}{${2:text}}"
    },
    {
      "name": "colorbox",
      "snippet": "colorbox{${1:color}}{${2:text}}"
    },
    {
      "name": "definecolor",
      "snippet": "definecolor{${1:name%specialDef}}{${2:model}}{${3:color-spec}}"
    },
    {
      "name": "fcolorbox",
      "snippet": "fcolorbox[${4:model}]{${1:border-color}}{${2:fill-color}}{${3:text}}"
    },
    {
      "name": "fcolorbox",
      "snippet": "fcolorbox{${1:border-color}}{${2:fill-color}}{${3:text}}"
    },
    {
      "name": "mathcolor",
      "snippet": "mathcolor[${3:model}]{${1:color}}{${2:math}}"
    },
    {
      "name": "mathcolor",
      "snippet": "mathcolor{${1:color}}{${2:math}}"
    },
    {
      "name": "nopagecolor"
    },
    {
      "name": "normalcolor"
    },
    {
      "name": "pagecolor",
      "snippet": "pagecolor{${1:color}}"
    },
    {
      "name": "textcolor",
      "snippet": "textcolor[${3:model}]{${1:color}}{${2:text}}"
    },
    {
      "name": "textcolor",
      "snippet": "textcolor{${1:color}}{${2:text}}"
    }
  ]
}
