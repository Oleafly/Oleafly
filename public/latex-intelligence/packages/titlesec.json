      "keyPos": 1,
      "keys": [
        "\\titleclass"
      ],
      "name": "titleclass",
      "snippet": "titleclass{${1:name}}{${2:class}}[${3:super-level-cmd}]"
    },
    {
      "keyPos": 1,
      "keys": [
        "\\titleformat#c"
      ],
      "name": "titleformat",
      "snippet": "titleformat{${1:command}}[${6:shape}]{${2:format}}{${3:label}}{${4:sep}}{${5:before-code}}"
    },
    {
      "keyPos": 1,
      "keys": [
        "\\titleformat#c"
      ],
      "name": "titleformat",
      "snippet": "titleformat{${1:command}}[${6:shape}]{${2:format}}{${3:label}}{${4:sep}}{${5:before-code}}[${7:after-code}]"
    },
    {
      "name": "titleformat",
      "snippet": "titleformat{${1:command}}{${2:format}}{${3:label}}{${4:sep}}{${5:before-code}}"
    },
    {
      "name": "titleformat*",
      "snippet": "titleformat*{${1:command}}{${2:format}}"
    },
    {
      "name": "titlelabel",
      "snippet": "titlelabel{${1:label-format}}"
    },
    {
      "keyPos": 0,
      "keys": [
        "\\titleline,\\titleline*"
      ],
      "name": "titleline",
      "snippet": "titleline[${2:align}]{${1:horizontal material}}"
    },
    {
      "name": "titleline",
      "snippet": "titleline{${1:horizontal material}}"
    },
    {
      "keyPos": 0,
      "keys": [
        "\\titleline,\\titleline*"
      ],
      "name": "titleline*",
      "snippet": "titleline*[${2:align}]{${1:horizontal material}}"
    },
    {
      "name": "titleline*",
      "snippet": "titleline*{${1:horizontal material}}"
    },
    {
      "name": "titlerule"
    },
    {
      "name": "titlerule",
      "snippet": "titlerule[${1:height}]"
    },
    {
      "name": "titlerule*",
      "snippet": "titlerule*[${2:width}]{${1:text}}"
    },
    {
      "name": "titlerule*",
      "snippet": "titlerule*{${1:text}}"
    },
    {
      "name": "titlespacing",
      "snippet": "titlespacing{${1:command}}{${2:left}}{${3:before-sep}}{${4:after-sep}}"
    },
    {
      "name": "titlespacing",
      "snippet": "titlespacing{${1:command}}{${2:left}}{${3:before-sep}}{${4:after-sep}}[${5:right-sep}]"
    },
    {
      "name": "titlespacing*",
      "snippet": "titlespacing*{${1:command}}{${2:left}}{${3:before-sep}}{${4:after-sep}}"
    },
    {
      "name": "titlespacing*",
      "snippet": "titlespacing*{${1:command}}{${2:left}}{${3:before-sep}}{${4:after-sep}}[${5:right-sep}]"
