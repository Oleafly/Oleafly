    {
      "name": "titlewidth",
      "unusual": true
    },
    {
      "name": "titlewidthfirst",
      "unusual": true
    },
    {
      "name": "titlewidthlast",
      "unusual": true
    },
    {
      "name": "wordsep",
      "unusual": true
    }
  ]
