{
  "args": [
    "\\usepackage/nth#c"
  ],
  "deps": [],
  "envs": [],
  "keys": {
    "\\usepackage/nth#c": [
      "super",
      "negative"
    ]
  },
  "macros": [
    {
      "name": "nth",
      "snippet": "nth{${1:number}}"
    },
    {
      "name": "nthM",
      "snippet": "nthM{${1:arg}}",
      "unusual": true
    },
    {
      "name": "nthSuff",
      "snippet": "nthSuff{${1:arg1}}{${2:arg2}}{${3:arg3}}",
      "unusual": true
    },
    {
      "name": "nthscript",
      "snippet": "nthscript{${1:arg}}",
      "unusual": true
    },
    {
      "name": "nthtest",
      "unusual": true
    },
    {
      "name": "ordinal",
      "snippet": "ordinal{${1:counter}}"
    }
  ]
}
