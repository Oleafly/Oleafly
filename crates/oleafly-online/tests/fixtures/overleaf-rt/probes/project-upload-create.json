{
  "probe": "project-upload-create",
  "description": "Alice creates projects from ZIP uploads (POST /project/new/upload): a project with \\title and \\documentclass and files the server ignores, one with neither, one wrapped in a single top-level folder, an invalid ZIP, an empty ZIP and no file; then invalid uploads until the 20 per minute limit answers. Records each reply, the resulting names, root docs and trees, and the server upload limit. Created projects are deleted.",
  "server": "Overleaf Community Edition 6.3.3 (sharelatex/sharelatex:6.3.3@sha256:fcdae66d4b642537d4f5ca8c814b9b2c7771395de5d5c51d14b52c4f542e5712)",
  "recordedAt": "2026-11-24",
  "notes": [
    "server limits: {\"maxUploadSize\":52428800,\"maxEntitiesPerProject\":2000,\"fileIgnorePattern\":\"**/{{__MACOSX,.git,.texpadtmp,.R,.venv,venv}{,/**},.!(latexmkrc),*.{dvi,aux,log,toc,out,pdfsync,synctex,synctex(busy),fdb_latexmk,fls,nlo,ind,glo,gls,glg,bbl,blg,doc,docx,gz,swp}}\"}",
    "titled: {\"name\":\"Uploaded From Oleafly\",\"rootDoc\":\"main.tex\",\"compiler\":\"pdflatex\",\"entities\":[{\"path\":\"/figures/pixel.png\",\"type\":\"file\"},{\"path\":\"/main.tex\",\"type\":\"doc\"},{\"path\":\"/refs.bib\",\"type\":\"doc\"},{\"path\":\"/sections/intro.tex\",\"type\":\"doc\"}]}",
    "untitled: {\"name\":\"Untitled Upload\",\"rootDoc\":\"paper.tex\",\"compiler\":\"pdflatex\",\"entities\":[{\"path\":\"/notes.tex\",\"type\":\"doc\"},{\"path\":\"/paper.tex\",\"type\":\"doc\"}]}",
    "same name: {\"name\":\"Untitled Upload (1)\",\"rootDoc\":\"paper.tex\",\"compiler\":\"pdflatex\",\"entities\":[{\"path\":\"/notes.tex\",\"type\":\"doc\"},{\"path\":\"/paper.tex\",\"type\":\"doc\"}]}",
    "wrapped: {\"name\":\"repo-main\",\"rootDoc\":\"main.tex\",\"compiler\":\"pdflatex\",\"entities\":[{\"path\":\"/img/pixel.png\",\"type\":\"file\"},{\"path\":\"/main.tex\",\"type\":\"doc\"}]}",
    "no tex: {\"name\":\"readme-only\",\"rootDoc\":null,\"compiler\":\"pdflatex\",\"entities\":[{\"path\":\"/readme.md\",\"type\":\"doc\"}]}",
    "upload attempt 13 of the burst answered 429 \"Rate limit reached, please try again later\" headers {\"transfer-encoding\":\"chunked\"}",
    "replies: a titled project with ignored files 200 {\"success\":true,\"project_id\":\"6b04faf5cb4fe3a455d4d615\"} | no \\title, the root is the doc with \\doc 200 {\"success\":true,\"project_id\":\"6b04faf6cb4fe3a455d4d630\"} | the same name again 200 {\"success\":true,\"project_id\":\"6b04faf6cb4fe3a455d4d643\"} | a single top-level folder 200 {\"success\":true,\"project_id\":\"6b04faf6cb4fe3a455d4d656\"} | no tex file at all 200 {\"success\":true,\"project_id\":\"6b04faf6cb4fe3a455d4d66b\"} | not a zip 422 {\"success\":false,\"error\":\"Invalid zip file\"} | an empty zip 422 {\"success\":false,\"error\":\"Invalid zip file\"} | no file 400 {\"success\":false,\"error\":\"invalid_upload_request\"} | invalid upload 1 for the rate limit 422 {\"success\":false,\"error\":\"Invalid zip file\"}"
  ],
  "steps": [
    {
      "serverLimits": {
        "maxUploadSize": 52428800,
        "maxEntitiesPerProject": 2000,
        "fileIgnorePattern": "**/{{__MACOSX,.git,.texpadtmp,.R,.venv,venv}{,/**},.!(latexmkrc),*.{dvi,aux,log,toc,out,pdfsync,synctex,synctex(busy),fdb_latexmk,fls,nlo,ind,glo,gls,glg,bbl,blg,doc,docx,gz,swp}}"
      }
    },
    {
      "label": "a titled project with ignored files",
      "request": {
        "method": "POST",
        "route": "/project/new/upload",
        "user": "alice",
        "upload": {
          "name": "my-archive.zip",
          "bytes": 1181
        }
      },
      "status": 200,
      "headers": {
        "content-length": "56",
        "content-type": "application/json; charset=utf-8"
      },
      "body": {
        "success": true,
        "project_id": "6b04faf5cb4fe3a455d4d615"
      },
      "sentAt": 1435,
      "answeredAt": 1762
    },
