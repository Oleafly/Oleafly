{
  "mainBinaryName": "oleafly-desktop",
  "bundle": {
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/oleafly": "./linux/oleafly",
          "/usr/share/kio/servicemenus/oleafly-open-folder.desktop": "linux/oleafly-open-folder.desktop",
          "/usr/share/nemo/actions/oleafly-open-folder.nemo_action": "linux/oleafly-open-folder.nemo_action"
        },
        "desktopTemplate": "linux/main.desktop"
      },
      "rpm": {
        "files": {
          "/usr/bin/oleafly": "./linux/oleafly",
          "/usr/share/kio/servicemenus/oleafly-open-folder.desktop": "linux/oleafly-open-folder.desktop",
          "/usr/share/nemo/actions/oleafly-open-folder.nemo_action": "linux/oleafly-open-folder.nemo_action"
        },
        "desktopTemplate": "linux/main.desktop"
      },
      "appimage": {
        "files": {
          "/usr/share/applications/Oleafly.desktop": "linux/appimage.desktop"
        }
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "Oleafly",
        "width": 1280,
        "height": 800,
        "transparent": false,
        "backgroundColor": "#09090b",
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "fullscreen": false,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ]
  }
}
