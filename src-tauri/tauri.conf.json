{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oleafly",
  "version": "0.3.13",
  "identifier": "com.oleafly.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Oleafly",
        "width": 1280,
        "height": 800,
        "transparent": true,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "fullscreen": false,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https://api.openalex.org https://api.alphaxiv.org; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/tectonic",
      "binaries/tectonic-biber",
      "binaries/typst"
    ],
    "resources": [
      "resources/templates/**/*",
      "resources/font-packs.json",
      "resources/template-packs.json",
      "resources/deadlines-seed.json",
      "resources/deadlines-extra.json",
      "resources/licenses/**/*",
      "resources/language-servers/**/*",
      "resources/skills/**/*",
      "resources/skills-catalog.json"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Oleafly/Oleafly/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFODU2Q0Q0QTZFMjA1NjgKUldSb0JlS20xR3lGYm5uQlNsYml5VWhrQUhYSXV0NnFVc0xINmNjWGgzM3pza3pWMXJWei9EbFYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
