[Desktop Entry]
Categories=Office;Publishing;WordProcessor;
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec=/usr/bin/{{exec}} %F
StartupWMClass={{exec}}
Icon={{icon}}
Keywords=LaTeX;TeX;Typst;Markdown;PDF;BibTeX;Citation;Paper;Thesis;Research;
MimeType=text/x-tex;text/vnd.typst;text/markdown;
Name={{name}}
Terminal=false
Type=Application
