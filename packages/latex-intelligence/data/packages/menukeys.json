{
  "args": [
    "\\usepackage/menukeys#c"
  ],
  "deps": [
    "adjustbox",
    "etoolbox",
    "kvoptions",
    "relsize",
    "tikz",
    "tikzlibrarycalc",
    "tikzlibraryshadows",
    "tikzlibraryshapes.symbols",
    "xcolor",
    "xstring"
  ],
  "envs": [],
  "keys": {
    "\\arrowkey#c": [
      "^",
      "v",
      ">",
      "<"
    ],
    "\\changemenucolor": [
      "bg",
      "br",
      "txt"
    ],
    "\\changemenuelement,\\changemenuelement*": [
      "single",
      "first",
      "middle",
      "last",
      "pre",
      "post",
      "set",
      "single"
    ],
    "\\renewmenustylesimple,\\renewmenustyle,\\newmenumacro,\\renewmenumacro,\\providemenumacro": [
      "menus",
      "roundedmenus",
      "angularmenus",
      "roundedkeys",
      "shadowedroundedkeys",
      "angularkeys",
      "shadowedangularkeys",
      "typewriterkeys",
      "paths",
      "pathswithfolder",
      "pathswithblackfolder",
      "hyphenatepaths",
      "hyphenatepathswithfolder",
      "hyphenatepathswithblackfolder"
    ],
    "\\usepackage/menukeys#c": [
      "definemenumacros",
      "definekeys",
      "mackeys=${1|text,symbols|}",
      "os=${1|mac,win|}"
    ]
  },
  "macros": [
    {
      "name": "Alt"
    },
    {
      "name": "AltGr"
    },
    {
      "name": "CurrentMenuElement",
      "unusual": true
    },
    {
      "name": "SPACE"
    },
    {
      "name": "Space"
    },
    {
      "keyPos": 0,
      "keys": [
        "\\arrowkey#c"
      ],
      "name": "arrowkey",
      "snippet": "arrowkey{${1:direction%keyvals}}"
    },
    {
      "name": "arrowkeydown"
    },
    {
      "name": "arrowkeyleft"
    },
    {
      "name": "arrowkeyright"
    },
    {
      "name": "arrowkeyup"
    },
    {
      "name": "backdel"
    },
    {
      "name": "backspace"
    },
    {
      "name": "capslock"
    },
    {
      "keyPos": 1,
      "keys": [
        "\\changemenucolor"
      ],
      "name": "changemenucolor",
      "snippet": "changemenucolor{${1:name}}{${2:element%keyvals}}{${3:model}}{${4:color definition}}",
      "unusual": true
    },
    {
      "name": "changemenucolortheme",
      "snippet": "changemenucolortheme{${1:name}}{${2:color theme}}",
      "unusual": true
    },
    {
      "keyPos": 1,
      "keys": [
        "\\changemenuelement,\\changemenuelement*"
      ],
      "name": "changemenuelement",
      "snippet": "changemenuelement{${1:name}}{${2:element%keyvals}}{${3:definition}}",
      "unusual": true
    },
    {
      "keyPos": 1,
      "keys": [
        "\\changemenuelement,\\changemenuelement*"
      ],
      "name": "changemenuelement*",
      "snippet": "changemenuelement*{${1:name}}{${2:element%keyvals}}{${3:definition}}",
      "unusual": true
    },
    {
      "name": "cmd"
    },
    {
      "name": "copymenucolortheme",
      "snippet": "copymenucolortheme{${1:copy}}{${2:original}}",
      "unusual": true
    },
    {
      "name": "copymenustyle",
      "snippet": "copymenustyle{${1:copy}}{${2:original}}",
      "unusual": true
    },
    {
      "name": "ctrl"
    },
    {
      "name": "ctrlname",
      "unusual": true
    },
    {
      "name": "del"
    },
    {
      "name": "delname",
      "unusual": true
    },
    {
      "name": "directory",
      "snippet": "directory[${2:separator}]{${1:path}}"
    },
    {
      "name": "directory",
      "snippet": "directory{${1:path}}"
    },
    {
      "name": "drawtikzfolder",
      "unusual": true
    },
    {
      "name": "drawtikzfolder",
      "snippet": "drawtikzfolder[${1:front fill color%color}]",
      "unusual": true
    },
    {
      "name": "drawtikzfolder",
      "snippet": "drawtikzfolder[${1:front fill color%color}][${2:draw color%color}]",
      "unusual": true
    },
    {
      "name": "enter"
    },
    {
      "name": "esc"
    },
    {
      "name": "keys",
      "snippet": "keys[${2:separator}]{${1:keys}}"
    },
    {
      "name": "keys",
      "snippet": "keys{${1:keys}}"
    },
    {
      "name": "menu",
      "snippet": "menu[${2:separator}]{${1:text}}"
    },
    {
      "name": "menu",
      "snippet": "menu{${1:text}}"
    },
    {
      "name": "newmenucolortheme",
      "snippet": "newmenucolortheme{${1:name}}{${2:model}}{${3:bg}}{${4:br}}{${5:txt}}[${6:a}][${7:b}][${8:c}]",
      "unusual": true
    },
    {
      "keyPos": 2,
      "keys": [
        "\\renewmenustylesimple,\\renewmenustyle,\\newmenumacro,\\renewmenumacro,\\providemenumacro"
      ],
      "name": "newmenumacro",
      "snippet": "newmenumacro{${1:macro%cmd}}[${3:input sep}]{${2:style%keyvals}}",
      "unusual": true
    },
    {
      "name": "newmenustyle",
      "snippet": "newmenustyle{${1:name}}[${7:pre}]{${2:first}}[${8:sep}]{${3:mid}}{${4:last}}{${5:single}}[${9:post}]{${6:theme}}",
      "unusual": true
    },
    {
      "name": "newmenustyle*",
      "snippet": "newmenustyle*{${1:name}}[${7:pre}]{${2:first}}[${8:sep}]{${3:mid}}{${4:last}}{${5:single}}[${9:post}]{${6:theme}}",
      "unusual": true
    },
    {
      "name": "newmenustylesimple",
      "snippet": "newmenustylesimple{${1:name}}[${4:pre}]{${2:style}}[${5:sep}][${6:post}]{${3:theme}}",
      "unusual": true
    },
    {
      "name": "newmenustylesimple*",
      "snippet": "newmenustylesimple*{${1:name}}[${4:pre}]{${2:style}}[${5:sep}][${6:post}]{${3:theme}}",
      "unusual": true
    },
    {
      "name": "oldesc"
    },
    {
      "keyPos": 2,
      "keys": [
        "\\renewmenustylesimple,\\renewmenustyle,\\newmenumacro,\\renewmenumacro,\\providemenumacro"
      ],
      "name": "providemenumacro",
      "snippet": "providemenumacro{${1:macro%cmd}}[${3:input sep}]{${2:style%keyvals}}",
      "unusual": true
    },
    {
      "name": "providemenustyle",
      "snippet": "providemenustyle{${1:name}}[${7:pre}]{${2:first}}[${8:sep}]{${3:mid}}{${4:last}}{${5:single}}[${9:post}]{${6:theme}}",
      "unusual": true
    },
    {
      "name": "providemenustyle*",
      "snippet": "providemenustyle*{${1:name}}[${7:pre}]{${2:first}}[${8:sep}]{${3:mid}}{${4:last}}{${5:single}}[${9:post}]{${6:theme}}",
      "unusual": true
    },
    {
      "name": "providemenustylesimple",
      "snippet": "providemenustylesimple{${1:name}}[${4:pre}]{${2:style}}[${5:sep}][${6:post}]{${3:theme}}",
      "unusual": true
    },
    {
      "name": "providemenustylesimple*",
      "snippet": "providemenustylesimple*{${1:name}}[${4:pre}]{${2:style}}[${5:sep}][${6:post}]{${3:theme}}",
      "unusual": true
    },
    {
      "name": "renewmenucolortheme",
      "snippet": "renewmenucolortheme{${1:name}}{${2:model}}{${3:bg}}{${4:br}}{${5:txt}}[${6:a}][${7:b}][${8:c}]",
      "unusual": true
    },
    {
      "keyPos": 2,
      "keys": [
        "\\renewmenustylesimple,\\renewmenustyle,\\newmenumacro,\\renewmenumacro,\\providemenumacro"
      ],
      "name": "renewmenumacro",
      "snippet": "renewmenumacro{${1:macro}}[${3:input sep}]{${2:style%keyvals}}",
      "unusual": true
    },
    {
      "keyPos": 6,
      "keys": [
        "\\renewmenustylesimple,\\renewmenustyle,\\newmenumacro,\\renewmenumacro,\\providemenumacro"
      ],
      "name": "renewmenustyle",
      "snippet": "renewmenustyle{${1:name}}[${7:pre}]{${2:first}}[${8:sep}]{${3:mid}}{${4:last}}{${5:single%keyvals}}[${9:post}]{${6:theme}}",
      "unusual": true
    },
    {
      "name": "renewmenustyle*",
      "snippet": "renewmenustyle*{${1:name}}[${7:pre}]{${2:first}}[${8:sep}]{${3:mid}}{${4:last}}{${5:single%keyvals}}[${9:post}]{${6:theme}}",
      "unusual": true
    },
    {
      "keyPos": 2,
      "keys": [
        "\\renewmenustylesimple,\\renewmenustyle,\\newmenumacro,\\renewmenumacro,\\providemenumacro"
      ],
      "name": "renewmenustylesimple",
      "snippet": "renewmenustylesimple{${1:name}}[${4:pre}]{${2:style%keyvals}}[${5:sep}][${6:post}]{${3:theme}}",
      "unusual": true
    },
    {
      "name": "renewmenustylesimple*",
      "snippet": "renewmenustylesimple*{${1:name}}[${4:pre}]{${2:style%keyvals}}[${5:sep}][${6:post}]{${3:theme}}",
      "unusual": true
    },
    {
      "name": "return"
    },
    {
      "name": "shift"
    },
    {
      "name": "spacename",
      "unusual": true
    },
    {
      "name": "tab"
    },
    {
      "name": "usemenucolor",
      "snippet": "usemenucolor{${1:element}}",
      "unusual": true
    },
    {
      "name": "winmenu"
    }
  ]
}
