{
  "args": [
    "\\captionsetup#c,\\captionsetup*#c,\\usepackage/caption#c,\\DeclareCaptionStyle#c,\\bicaptionsetup#c,\\bicaptionsetup*#c,\\subcaptionsetup#c,\\subcaptionsetup*#c",
    "\\usepackage/caption#c"
  ],
  "deps": [
    "caption3",
    "ltcaption",
    "ragged2e",
    "sansmath",
    "setspace"
  ],
  "envs": [
    {
      "name": "captionblock",
      "snippet": "[${2:position}][${3:height}][${4:inner-pos}]{${1:width}}"
    },
    {
      "name": "captionblock",
      "snippet": "[${2:position}][${3:height}]{${1:width}}"
    },
    {
      "name": "captionblock",
      "snippet": "[${2:position}]{${1:width}}"
    },
    {
      "name": "captionblock",
      "snippet": "{${1:width}}"
    },
    {
      "name": "captiongroup",
      "unusual": true
    },
    {
      "name": "captiongroup*",
      "unusual": true
    }
  ],
  "keys": {
    "\\captionsetup#c,\\captionsetup*#c,\\usepackage/caption#c,\\DeclareCaptionStyle#c,\\bicaptionsetup#c,\\bicaptionsetup*#c,\\subcaptionsetup#c,\\subcaptionsetup*#c": [
      "list-entry=${1|default,list-entry,entry|}",
      "hypcap",
      "hypcapspace=",
      "type=${1:float type}",
      "type*=${1:float type}",
      "subtype=${1:float type}",
      "subtype*=${1:float type}"
    ],
    "\\usepackage/caption#c": [
      "compatibility",
      "config=${1:file name}"
    ]
  },
  "macros": [
    {
      "name": "ContinuedFloat"
    },
    {
      "name": "ContinuedFloat*"
    },
    {
      "name": "caption*",
      "snippet": "caption*{${1:heading}}"
    },
    {
      "name": "captionbox",
      "snippet": "captionbox[${3:list entry}]{${1:heading}}[${4:width}][${5:inner-pos}]{${2:content}}"
    },
    {
      "name": "captionbox",
      "snippet": "captionbox[${3:list entry}]{${1:heading}}[${4:width}]{${2:content}}"
    },
    {
      "name": "captionbox",
      "snippet": "captionbox[${3:list entry}]{${1:heading}}{${2:content}}"
    },
    {
      "name": "captionbox",
      "snippet": "captionbox{${1:heading}}[${3:width}][${4:inner-pos}]{${2:content}}"
    },
    {
      "name": "captionbox",
      "snippet": "captionbox{${1:heading}}[${3:width}]{${2:content}}"
    },
    {
      "name": "captionbox",
      "snippet": "captionbox{${1:heading}}{${2:content}}"
    },
    {
      "name": "captionbox*",
      "snippet": "captionbox*{${1:heading}}[${3:width}][${4:inner-pos}]{${2:content}}"
    },
    {
      "name": "captionbox*",
      "snippet": "captionbox*{${1:heading}}[${3:width}]{${2:content}}"
    },
    {
      "name": "captionbox*",
      "snippet": "captionbox*{${1:heading}}{${2:content}}"
    },
    {
      "name": "captionlistentry",
      "snippet": "captionlistentry[${2:float type}]{${1:list entry}}"
    },
    {
      "name": "captionlistentry",
      "snippet": "captionlistentry{${1:list entry}}"
    },
    {
      "name": "captionof",
      "snippet": "captionof{${1:float type}}[${3:list entry}]{${2:heading}}"
    },
    {
      "name": "captionof",
      "snippet": "captionof{${1:float type}}{${2:heading}}"
    },
    {
      "name": "captionof*",
      "snippet": "captionof*{${1:float type}}{${2:heading}}"
    },
    {
      "name": "captiontext",
      "snippet": "captiontext[${2:number}]{${1:text}}"
    },
    {
      "name": "captiontext",
      "snippet": "captiontext{${1:text}}"
    },
    {
      "name": "captiontext*",
      "snippet": "captiontext*[${2:number}]{${1:text}}"
    },
    {
      "name": "captiontext*",
      "snippet": "captiontext*{${1:text}}"
    },
    {
      "name": "flushsubcaptionlistentries",
      "unusual": true
    },
    {
      "name": "nextfloat"
    },
    {
      "name": "nextfloat*"
    },
    {
      "name": "phantomcaption"
    },
    {
      "name": "piccaptiontype",
      "snippet": "piccaptiontype{${1:float type}}",
      "unusual": true
    },
    {
      "name": "setcaptionsubtype",
      "snippet": "setcaptionsubtype{${1:float type}}"
    },
    {
      "name": "setcaptionsubtype*"
    },
    {
      "name": "setcaptiontype",
      "snippet": "setcaptiontype{${1:float type}}"
    },
    {
      "name": "setcaptiontype*"
    },
    {
      "name": "subcaptionsetup",
      "snippet": "subcaptionsetup[${2:float type}]{${1:options}}"
    },
    {
      "name": "subcaptionsetup",
      "snippet": "subcaptionsetup{${1:options}}"
    },
    {
      "name": "subcaptionsetup*",
      "snippet": "subcaptionsetup*[${2:float type}]{${1:options}}",
      "unusual": true
    },
    {
      "name": "subcaptionsetup*",
      "snippet": "subcaptionsetup*{${1:options}}",
      "unusual": true
    },
    {
      "name": "theContinuedFloat",
      "unusual": true
    }
  ]
}
