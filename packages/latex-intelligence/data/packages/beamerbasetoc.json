{
  "args": [],
  "deps": [],
  "envs": [],
  "keys": {
    "\\tableofcontents": [
      "currentsection",
      "currentsubsection",
      "firstsection=${1:section number}",
      "hideallsubsections",
      "hideothersubsections",
      "lastsection=${1:section number}",
      "part=${1:part number}",
      "pausesections",
      "pausesubsections",
      "sections={${1:overlay specification}}",
      "sectionstyle=${1:current}/${2:other}",
      "subsectionstyle=${1:current}/${2:other in current}/${3:other}",
      "subsubsectionstyle=${1:current}/${2:other in current}/${3:other in other}/${4:other}"
    ]
  },
  "macros": [
    {
      "name": "inserttocsection",
      "unusual": true
    },
    {
      "name": "inserttocsectionnumber",
      "unusual": true
    },
    {
      "name": "inserttocsubsection",
      "unusual": true
    },
    {
      "name": "inserttocsubsectionnumber",
      "unusual": true
    },
    {
      "name": "inserttocsubsubsection",
      "unusual": true
    },
    {
      "name": "inserttocsubsubsectionnumber",
      "unusual": true
    },
    {
      "keyPos": 0,
      "keys": [
        "\\tableofcontents"
      ],
      "name": "tableofcontents",
      "snippet": "tableofcontents[${1:options}]"
    }
  ]
}
