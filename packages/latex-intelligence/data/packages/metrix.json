{
  "args": [],
  "deps": [
    "tikz",
    "tikzlibrarycalc",
    "xpatch"
  ],
  "envs": [
    {
      "name": "metricverses"
    },
    {
      "name": "metricverses",
      "snippet": "[${1:source}]"
    },
    {
      "name": "symbolline"
    }
  ],
  "keys": {
    "\\setmetrixvar,\\usemetrixvar": [
      "symbollinewidth",
      "bigsymbollinewidth",
      "accentlinewidth",
      "bowlinewidth",
      "symbolsep",
      "baseunit",
      "bigbaseunit",
      "shortsyllablelimit",
      "gap",
      "symbolshift",
      "lngshift",
      "lngshortening",
      "lngminlength",
      "brvshift",
      "dotshift",
      "itcorrection",
      "accentxshift",
      "bowshift",
      "bowshortening",
      "bowlooseness",
      "symbolcolor",
      "accentcolor",
      "bowcolor",
      "highlightcolor",
      "fillcolor",
      "arrow",
      "breakgap",
      "emptywidth",
      "acute",
      "grave"
    ]
  },
  "macros": [
    {
      "name": "acct",
      "snippet": "acct{${1:vowel}}"
    },
    {
      "name": "bow",
      "snippet": "bow{${1:syllables}}"
    },
    {
      "name": "brv",
      "snippet": "brv{${1:vowel}}"
    },
    {
      "name": "lng",
      "snippet": "lng{${1:vowel}}"
    },
    {
      "name": "metrics",
      "snippet": "metrics[${3:number=higlighting}]{${1:symbols}}{${2:syllables}}"
    },
    {
      "name": "metrics",
      "snippet": "metrics{${1:symbols}}{${2:syllables}}"
    },
    {
      "name": "metricsymbols",
      "snippet": "metricsymbols[${2:number=higlighting}]{${1:symbols}}"
    },
    {
      "name": "metricsymbols",
      "snippet": "metricsymbols{${1:symbols}}"
    },
    {
      "name": "metricsymbols*",
      "snippet": "metricsymbols*[${2:number=higlighting}]{${1:symbols}}"
    },
    {
      "name": "metricsymbols*",
      "snippet": "metricsymbols*{${1:symbols}}"
    },
    {
      "keyPos": 0,
      "keys": [
        "\\setmetrixvar,\\usemetrixvar"
      ],
      "name": "setmetrixvar",
      "snippet": "setmetrixvar{${1:variable}}{${2:value}}"
    },
    {
      "keyPos": 0,
      "keys": [
        "\\setmetrixvar,\\usemetrixvar"
      ],
      "name": "usemetrixvar",
      "snippet": "usemetrixvar{${1:variable}}"
    },
    {
      "name": "verseref",
      "snippet": "verseref{${1:reference}}"
    }
  ]
}
